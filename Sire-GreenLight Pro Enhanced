indicator('Sire-GreenLight Pro Enhanced', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 1000)

// ═══════════════════════════════════════════════════════════════
// SECTION A — GREENLIGHT PRO INPUTS
// ═══════════════════════════════════════════════════════════════
var g_cave   = 'GL: GreenLight Core Settings'
var g_struct = 'GL: Structure Detection'
var g_gap    = 'GL: Brooks Gap 20 Bar'
var g_dash   = 'GL: Dashboard Settings'
var g_count  = 'GL: Bar Counter'
var g_18bar  = 'GL: 18-Bar RTH Box'
var g_score  = 'GL: Signal Quality Scoring'
var g_risk   = 'GL: Risk/Reward Overlay'
var g_alerts = 'GL: Alert Conditions'

// Core
gl_emaLen   = input.int(20,    'EMA Length',            group = g_cave)
gl_atrLen   = input.int(14,    'ATR Length',            group = g_cave)
gl_distMult = input.float(0.75,'Max Distance from EMA', group = g_cave, step = 0.1)
gl_volMult  = input.float(1.2, 'Volume Multiplier',     group = g_cave, step = 0.1)
gl_trigLvl  = input.int(8,     'Trigger Level (L8/B8)', group = g_cave)

// Structure Detection
gl_swingLen   = input.int(10,   'Swing Lookback (bars)',     group = g_struct, minval = 3)
gl_trRangeATR = input.float(3.0,'TR Range (x ATR)',          group = g_struct, step = 0.5)

// Gap 20
gl_showGap = input.bool(true, 'Enable Gap 20 Bar Tracker', group = g_gap)

// Dashboard
gl_showDash = input.bool(true, 'Show Momentum Dashboard', group = g_dash)
gl_dashPos  = input.string('bottom_right', 'Dashboard Position', group = g_dash, options = ['top_right','bottom_right','top_left','bottom_left'])
gl_textSize = input.string('normal',       'Text Size',          group = g_dash, options = ['tiny','small','normal','large','huge'])
gl_showSessionStats = input.bool(true, 'Show Session Stats', group = g_dash)

// Bar Counter
gl_showCnt  = input.bool(true,  'Show RTH Bar Numbers',  group = g_count)
gl_enableBC = input.bool(true,  'Enable Bar Counter',    group = g_count)
gl_showETH  = input.bool(true,  'Show ETH Bar Numbers',  group = g_count, tooltip = 'Labels pre/post market bars as E1, E2, E3... Resets each RTH open.')
gl_ethColor = input.color(color.new(color.gray, 40), 'ETH Label Color', group = g_count)

// 18-Bar RTH Box
gl_showBox   = input.bool(true,          'Show 18-Bar Box',  group = g_18bar)
gl_boxColor  = input.color(color.orange, 'Box Color',        group = g_18bar)
gl_boxTrans  = input.int(80,             'Box Transparency', group = g_18bar, minval = 0)
gl_showLabel = input.bool(true,          'Show Range Label', group = g_18bar)
gl_coilColor = input.color(color.yellow, 'Coil (<30% ADR)',  group = g_18bar)
gl_boColor   = input.color(color.green,  'BO (30–50% ADR)',  group = g_18bar)
gl_trColor   = input.color(color.red,    'TR (>50% ADR)',    group = g_18bar)

// Signal Quality Scoring
gl_scoreEma    = input.bool(true, 'Score: EMA Agreement',      group = g_score)
gl_scoreVol    = input.bool(true, 'Score: Volume Confirmation', group = g_score)
gl_scoreStruct = input.bool(true, 'Score: Structure Alignment', group = g_score)
gl_scoreGap    = input.bool(true, 'Score: Gap 20 Context',      group = g_score)
gl_minScore    = input.int(3,    'Min Confluence Score (0-4)',   group = g_score, minval = 0, maxval = 4)

// Risk/Reward Overlay
gl_showRR   = input.bool(true,  'Show R:R on Signals', group = g_risk)
gl_rrRatio  = input.float(2.0,  'Target R:R Ratio',    group = g_risk, step = 0.5)

// Alerts
gl_alertL8   = input.bool(true, 'Alert on L8 Signal',   group = g_alerts)
gl_alertB8   = input.bool(true, 'Alert on B8 Signal',   group = g_alerts)
gl_alertL4   = input.bool(true, 'Alert on L4 Signal',   group = g_alerts)
gl_alertB4   = input.bool(true, 'Alert on B4 Signal',   group = g_alerts)
gl_alertGap  = input.bool(true, 'Alert on Gap 20 Close', group = g_alerts)
gl_alertWedge = input.bool(true, 'Alert on Wedge Pattern', group = g_alerts)

// ═══════════════════════════════════════════════════════════════
// SECTION B — SIRETACTICS v3.3 INPUTS
// ═══════════════════════════════════════════════════════════════
var G_STATS   = '📊 Opening Range Stats'
var G_EMA     = '📈 EMA Overlay'
var G_GAPS    = '⚪ Gap Detection'
var G_TD      = '🔴 TD Sequential'
var G_PATTERNS= '🕯 Candle Patterns'
var G_VOL     = '📊 ATR / ABR'
var G_BO      = '🚀 Breakout Bar'
var G_LEG     = '📐 Two-Leg Structure'
var G_WM      = '🖊 Watermark'
var G_WMPOS   = '📌 Watermark Position'
var G_STYLE   = '🎨 Global Styling'
var G_BARCOL  = '🎨 Bar Color Toggles'
var G_MTF     = '📊 Multi-Timeframe'

// Opening Range Stats
showTrendFilter = input.bool(true,  'Enable Trend vs. Chop Filter', group = G_STATS)
openingBarLimit = input.int(8,      'Opening Range Bar Count',      group = G_STATS, minval = 1, maxval = 20)
useTimeFilter   = input.bool(true,  'RTH Only (9:30–16:00)',        group = G_STATS)
chopThreshold   = input.float(0.35, 'Chop Threshold (0–1)',         group = G_STATS, minval = 0.1, maxval = 0.9, step = 0.05)

// Global Styling
colorEMAUp   = input.color(color.green, 'EMA Up Color',         group = G_STYLE)
colorEMADown = input.color(color.red,   'EMA Down Color',        group = G_STYLE)
lbl_offset   = input.float(0.05,        'Global Label Offset %', group = G_STYLE, minval = 0.0, maxval = 5.0, step = 0.01)

// Bar Color Toggles
enableInsideBarColor  = input.bool(true,  'Inside Bar Colors',       group = G_BARCOL)
enableBOColor         = input.bool(true,  'Breakout Bar Colors',     group = G_BARCOL)
enableLateLegColor    = input.bool(true,  'Late Leg Bar Colors',     group = G_BARCOL)
enableTrendBarColor   = input.bool(true,  'HH/HL/LH/LL Bar Colors', group = G_BARCOL)

// ATR / ABR
abrLen    = input.int(8, 'ABR Lookback', group = G_VOL, minval = 1)
abr       = ta.sma(high - low, abrLen)
atrLen_st = input.int(8,   'ATR Length',     group = G_VOL, minval = 1)
atrSmooth = input.string('RMA', 'ATR Smoothing', group = G_VOL, options = ['RMA','SMA','EMA','WMA'])

// EMA Overlay
showFastEMA = input.bool(false, 'Show Fast EMA (9)',  group = G_EMA)
showMTFEMA  = input.bool(false, 'Show MTF EMA (200)', group = G_EMA)
showEMAcloud = input.bool(false,'Show EMA Cloud',     group = G_EMA)
emaLenFast  = input.int(9,   'Fast EMA Length',  group = G_EMA, minval = 2)
emaLenMTF   = input.int(200, 'MTF EMA Length',   group = G_EMA, minval = 1)
emaTF       = input.timeframe('30', 'MTF Timeframe', group = G_EMA)
colorFast   = input.color(color.rgb(221, 110, 19), 'Fast Color', group = G_EMA)

// Multi-Timeframe Structure
showMTFStruct   = input.bool(false, 'Show MTF Structure Filter', group = G_MTF)
mtfStructLookback = input.int(20,    'MTF Structure Lookback',   group = G_MTF, minval = 5)

// ═══════════════════════════════════════════════════════════════
// SECTION C — SHARED CALCULATIONS
// ═══════════════════════════════════════════════════════════════

if barstate.isfirst and timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds('D')
    runtime.error('Timeframe too high — use a sub-daily timeframe.')

// ── Helper Functions ──────────────────────────────────────────
f_size(s) => s == 'tiny' ? size.tiny : s == 'small' ? size.small : s == 'normal' ? size.normal : s == 'large' ? size.large : size.huge
f_pos(p)  => p == 'top_right' ? position.top_right : p == 'bottom_right' ? position.bottom_right : p == 'top_left' ? position.top_left : position.bottom_left
f_statePos(p) => p == 'top_right' ? position.top_right : p == 'top_left' ? position.top_left : p == 'bottom_right' ? position.bottom_right : position.bottom_left

// ── GL Core ──────────────────────────────────────────────────
gl_emaVal     = ta.ema(close, gl_emaLen)
gl_atr        = ta.atr(gl_atrLen)
gl_avgVol     = ta.sma(volume, 20)
gl_emaRising  = gl_emaVal > gl_emaVal[1]
gl_emaFalling = gl_emaVal < gl_emaVal[1]
gl_isNearEma  = math.abs(close - gl_emaVal) < gl_atr * gl_distMult
gl_highVol    = volume > gl_avgVol * gl_volMult

gl_swingHigh = ta.pivothigh(high, gl_swingLen, gl_swingLen)
gl_swingLow  = ta.pivotlow(low,  gl_swingLen, gl_swingLen)

var float gl_lastH1 = na
var float gl_lastH2 = na
var float gl_lastL1 = na
var float gl_lastL2 = na

if not na(gl_swingHigh)
    gl_lastH2 := gl_lastH1
    gl_lastH1 := gl_swingHigh
if not na(gl_swingLow)
    gl_lastL2 := gl_lastL1
    gl_lastL1 := gl_swingLow

bool gl_swingUp = not na(gl_lastH1) and not na(gl_lastH2) and not na(gl_lastL1) and not na(gl_lastL2) and gl_lastH1 > gl_lastH2 and gl_lastL1 > gl_lastL2
bool gl_swingDn = not na(gl_lastH1) and not na(gl_lastH2) and not na(gl_lastL1) and not na(gl_lastL2) and gl_lastH1 < gl_lastH2 and gl_lastL1 < gl_lastL2

gl_rangeSize  = ta.highest(high, gl_swingLen) - ta.lowest(low, gl_swingLen)
bool gl_isTR  = gl_rangeSize < gl_atr * gl_trRangeATR

bool gl_inUp    = gl_emaRising  and gl_swingUp and not gl_isTR
bool gl_inDn    = gl_emaFalling and gl_swingDn and not gl_isTR
bool gl_inTrend = gl_inUp or gl_inDn
bool gl_inTR    = gl_isTR or (not gl_swingUp and not gl_swingDn)

gl_structLbl = gl_inUp ? 'UPTREND' : gl_inDn ? 'DOWNTREND' : gl_inTR ? 'TRADING RANGE' : 'MIXED'
gl_structCol = gl_inUp ? color.green : gl_inDn ? color.red : color.orange

var int gl_bearStr = 0
var int gl_bullStr = 0
bool gl_bearMom = close < open and close < close[1]
bool gl_bullMom = close > open and close > close[1]
if gl_bearMom
    gl_bearStr := gl_bearStr + 1
    gl_bullStr := 0
else if gl_bullMom
    gl_bullStr := gl_bullStr + 1
    gl_bearStr := 0
else
    gl_bearStr := 0
    gl_bullStr := 0

// ── GL Gap-20 ────────────────────────────────────────────────
var int gl_gapCnt = 0
bool gl_touchEma  = low <= gl_emaVal and high >= gl_emaVal
gl_gapCnt        := gl_touchEma ? 0 : gl_gapCnt + 1
bool gl_gapClosed = gl_showGap and gl_touchEma and gl_gapCnt[1] >= 20

// ── Signal Quality Scoring ────────────────────────────────────
gl_signalScore(int dir) =>
    int s = 0
    if dir == 1
        s += (gl_scoreEma    and gl_emaRising)  ? 1 : 0
        s += (gl_scoreVol    and gl_highVol)    ? 1 : 0
        s += (gl_scoreStruct and gl_inUp)       ? 1 : 0
        s += (gl_scoreGap    and gl_gapCnt >= 20) ? 1 : 0
    else
        s += (gl_scoreEma    and gl_emaFalling) ? 1 : 0
        s += (gl_scoreVol    and gl_highVol)    ? 1 : 0
        s += (gl_scoreStruct and gl_inDn)       ? 1 : 0
        s += (gl_scoreGap    and gl_gapCnt >= 20) ? 1 : 0
    s

gl_longScore  = gl_signalScore(1)
gl_shortScore = gl_signalScore(-1)

gl_baseLong  = gl_bullStr == gl_trigLvl and close > gl_emaVal and gl_emaRising  and gl_isNearEma and gl_highVol
gl_baseShort = gl_bearStr == gl_trigLvl and close < gl_emaVal and gl_emaFalling and gl_isNearEma and gl_highVol

// ── Multi-Timeframe Structure Filter ──────────────────────────
float mtfHigh = request.security(syminfo.tickerid, emaTF, ta.highest(high, mtfStructLookback))
float mtfLow  = request.security(syminfo.tickerid, emaTF, ta.lowest(low, mtfStructLookback))
bool  mtfBullStruct = close > mtfHigh
bool  mtfBearStruct = close < mtfLow

gl_longTrig  = gl_baseLong  and gl_inTrend and not gl_inTR and gl_longScore  >= gl_minScore
gl_shortTrig = gl_baseShort and gl_inTrend and not gl_inTR and gl_shortScore >= gl_minScore

if showMTFStruct
    gl_longTrig  := gl_longTrig  and mtfBullStruct
    gl_shortTrig := gl_shortTrig and mtfBearStruct

// ── Unified Session / Bar Counter ────────────────────────────
gl_isRTHStart = not na(time('', '0930-0931', 'America/New_York')) and na(time('', '0930-0931', 'America/New_York')[1])
gl_isInRTH    = not na(time('', '0930-1600', 'America/New_York'))
gl_isInETH    = not gl_isInRTH and not na(time)

var int gl_rthBarNum = 0
if gl_isRTHStart
    gl_rthBarNum := 1
else if gl_isInRTH
    gl_rthBarNum := gl_rthBarNum + 1
else
    gl_rthBarNum := 0

var int gl_ethBarNum = 0
if gl_isRTHStart
    gl_ethBarNum := 0
else if gl_isInETH
    gl_ethBarNum := gl_ethBarNum + 1

// ── GL 18-Bar RTH Box ────────────────────────────────────────
gl_rthOpen      = timestamp('America/New_York', year, month, dayofmonth, 9, 30)
gl_barsSinceRTH = ta.barssince(time >= gl_rthOpen and time[1] < gl_rthOpen)
gl_adr          = ta.sma(ta.highest(high, 20) - ta.lowest(low, 20), 8)

var float gl_hi18 = na
var float gl_lo18 = na

if gl_barsSinceRTH == 0
    gl_hi18 := high
    gl_lo18 := low
else if gl_barsSinceRTH < 18
    gl_hi18 := math.max(gl_hi18, high)
    gl_lo18 := math.min(gl_lo18, low)

if gl_barsSinceRTH == 17
    gl_range18 = gl_hi18 - gl_lo18
    gl_pctADR  = gl_range18 / gl_adr * 100
    gl_col18   = gl_pctADR < 30 ? gl_coilColor : gl_pctADR <= 50 ? gl_boColor : gl_trColor
    if gl_showBox
        box.new(bar_index - 17, gl_hi18, bar_index, gl_lo18, border_color = gl_boxColor, bgcolor = color.new(gl_boxColor, gl_boxTrans))
    if gl_showLabel
        label.new(bar_index, gl_hi18, str.tostring(math.round(gl_range18, 2)) + ' pts (' + str.tostring(math.round(gl_pctADR)) + '%)', style = label.style_label_down, color = gl_col18, textcolor = color.black)

// ── Session Statistics ────────────────────────────────────────
var int   gl_sessionSignals = 0
var float gl_sessionScore   = 0.0

if gl_isRTHStart
    gl_sessionSignals := 0
    gl_sessionScore   := 0.0

if gl_longTrig
    gl_sessionSignals += 1
    gl_sessionScore   += gl_longScore
if gl_shortTrig
    gl_sessionSignals += 1
    gl_sessionScore   += gl_shortScore

gl_sessionAvgScore = gl_sessionSignals > 0 ? gl_sessionScore / gl_sessionSignals : 0.0

// ── ST Session ───────────────────────────────────────────────
st_is_rth    = not useTimeFilter or time(timeframe.period, '0930-1600:23456') != 0
st_is_new_day = ta.change(time('D')) != 0

var int   st_bar_count = 0
var float s_open       = na
var float s_high       = 0.0
var float s_low        = 999999.0

if st_is_new_day
    st_bar_count := 1
    s_open       := open
    s_high       := high
    s_low        := low
else
    st_bar_count := st_bar_count + 1
    s_high       := math.max(s_high, high)
    s_low        := math.min(s_low,  low)

trend_ratio = s_high - s_low != 0 ? math.abs(close - s_open) / (s_high - s_low) : 0
is_choppy   = showTrendFilter and st_bar_count >= openingBarLimit and trend_ratio <= chopThreshold

// ── ST Bar Metrics ───────────────────────────────────────────
barRange = high - low

// ── ST EMAs (supplementary) ───────────────────────────────────
emaFast   = ta.ema(close, emaLenFast)
ema200raw = request.security(syminfo.tickerid, emaTF, ta.ema(close, emaLenMTF), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
ema200Color = ema200raw > ema200raw[1] ? colorEMAUp : colorEMADown

// ── ST ATR ───────────────────────────────────────────────────
true_range = math.max(barRange, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr_val    = switch atrSmooth
    'RMA' => ta.rma(true_range, atrLen_st)
    'SMA' => ta.sma(true_range, atrLen_st)
    'EMA' => ta.ema(true_range, atrLen_st)
    'WMA' => ta.wma(true_range, atrLen_st)
    =>       ta.rma(true_range, atrLen_st)
atr_pct = close != 0 ? atr_val / close * 100 : 0.0
abr_pct = close != 0 ? abr     / close * 100 : 0.0

// ── ST Breakout Bar ──────────────────────────────────────────
boMultiplier = input.float(1.5, 'BO Size (x ABR)', group = G_BO, minval = 1.0, maxval = 4.0, step = 0.1)
showBO       = input.bool(true, 'Highlight BO Bars', group = G_BO)

bullBO     = barRange > abr * boMultiplier and close > high[1] and high - close < barRange * 0.25
bearBO     = barRange > abr * boMultiplier and close < low[1]  and close - low  < barRange * 0.25

// ── ST Two-Leg ───────────────────────────────────────────────
legPivotLen = input.int(5,    'Pivot Length',     group = G_LEG, minval = 3, maxval = 20)
showLegs    = input.bool(true,'Show Leg Labels',  group = G_LEG)

pivHigh = ta.pivothigh(high, legPivotLen, legPivotLen)
pivLow  = ta.pivotlow(low,  legPivotLen, legPivotLen)

var float pH1 = na
var float pH2 = na
var float pL1 = na
var float pL2 = na

if not na(pivHigh)
    pH2 := pH1
    pH1 := pivHigh
if not na(pivLow)
    pL2 := pL1
    pL1 := pivLow

// ── ST Late Leg / 3-Push ─────────────────────────────────────
var int trendUp = 0
var int trendDn = 0
trendUp := close > close[1] ? trendUp + 1 : close < close[1] ? 0 : trendUp
trendDn := close < close[1] ? trendDn + 1 : close > close[1] ? 0 : trendDn

lateLegUp = trendUp >= 5
lateLegDn = trendDn >= 5

var int pushUp = 0
var int pushDn = 0
if not na(pivHigh)
    pushUp := not na(pH2) and pH1 > pH2 ? pushUp + 1 : 0
if not na(pivLow)
    pushDn := not na(pL2) and pL1 < pL2 ? pushDn + 1 : 0

wedgeUp = pushUp >= 3
wedgeDn = pushDn >= 3

// ── ST TD Sequential ─────────────────────────────────────────
show_td       = input.bool(true,   'Show TD Sequential',            group = G_TD)
td_size       = input.string('small','Label Size',                  group = G_TD, options = ['tiny','small','normal','large','huge'])
show_td_line  = input.bool(true,   'Show TD Lines',                 group = G_TD)
show_td_trail = input.bool(true,   'TD Pulse on Countdown',         group = G_TD)
td_ext        = input.int(20,      'Extend Lines Forward',          group = G_TD, minval = 2)
show_td_inter = input.bool(false,  'Show Intermediate Counts (1–8)', group = G_TD)
show_cd_inter = input.bool(false,  'Show Countdown Counts (1–12)',  group = G_TD)

C_TD_BULL    = color.new(#20a249, 0)
C_TD_BEAR    = color.new(#fc0c0c, 0)
C_TD_CD_BULL = color.new(color.green, 0)
C_TD_CD_BEAR = color.new(color.red,   0)
C_TD_TRAIL   = color.new(color.yellow, 80)

f_td_label(x, y, txt, bg)  => label.new(x, y, txt, color = bg, textcolor = color.white, style = label.style_label_center, size = td_size)
f_td_line(x, y, isBull)    => line.new(x, y, x + td_ext, y, color = isBull ? color.green : color.red, style = line.style_solid, width = 2)
f_td_inter(x, y, txt, bg)  => label.new(x, y, txt, color = color.new(bg, 60), textcolor = color.new(color.white, 20), style = label.style_label_center, size = size.tiny)

var int  td_up      = 0
var int  td_dn      = 0
var int  td_buy_cd  = 0
var int  td_sell_cd = 0
var bool perf_up    = false
var bool perf_dn    = false

bull_cond = close > close[4]
bear_cond = close < close[4]

if bull_cond
    td_up := bull_cond[1] ? td_up + 1 : 1
    td_dn := 0
else if bear_cond
    td_dn := bear_cond[1] ? td_dn + 1 : 1
    td_up := 0

if show_td and show_td_inter and barstate.isconfirmed
    if td_up > 0 and td_up < 9
        f_td_inter(bar_index, high * (1 + lbl_offset / 100), str.tostring(td_up), C_TD_BULL)
    if td_dn > 0 and td_dn < 9
        f_td_inter(bar_index, low  * (1 - lbl_offset / 100), str.tostring(td_dn), C_TD_BEAR)

td_up9 = show_td and td_up == 9 and barstate.isconfirmed
td_dn9 = show_td and td_dn == 9 and barstate.isconfirmed

if td_up9
    f_td_label(bar_index, high * (1 + lbl_offset / 100), '9', C_TD_BULL)
    if show_td_line
        f_td_line(bar_index, high, true)
    perf_up    := true
    td_buy_cd  := 0
    perf_dn    := false

if td_dn9
    f_td_label(bar_index, low * (1 - lbl_offset / 100), '9', C_TD_BEAR)
    if show_td_line
        f_td_line(bar_index, low, false)
    perf_dn    := true
    td_sell_cd := 0
    perf_up    := false

buy_cd_cond  = perf_dn and close <= low[2]
sell_cd_cond = perf_up and close >= high[2]

if buy_cd_cond  and td_buy_cd  < 13
    td_buy_cd  := td_buy_cd  + 1
if sell_cd_cond and td_sell_cd < 13
    td_sell_cd := td_sell_cd + 1

if td_buy_cd >= 13
    td_buy_cd := 0
    perf_dn := false
if td_sell_cd >= 13
    td_sell_cd := 0
    perf_up := false

if show_td and show_cd_inter and barstate.isconfirmed
    if td_buy_cd  > 0 and td_buy_cd  < 13
        f_td_inter(bar_index, low  * (1 - lbl_offset / 100), str.tostring(td_buy_cd),  C_TD_CD_BULL)
    if td_sell_cd > 0 and td_sell_cd < 13
        f_td_inter(bar_index, high * (1 + lbl_offset / 100), str.tostring(td_sell_cd), C_TD_CD_BEAR)

// ── HH / HL / LH / LL Detection ─────────────────────────────
lb           = input.int(5,   'Left Bars',              minval = 1)
rb           = input.int(5,   'Right Bars',             minval = 1)
search_limit = input.int(100, 'Max Lookback for Pivots', minval = 50, maxval = 500)
showresline  = input.bool(true, 'Show Resistance Line', inline = 'rescol')
rescol       = input.color(color.red,  '',              inline = 'rescol')
showsupline  = input.bool(true, 'Show Support Line',    inline = 'supcol')
supcol       = input.color(color.lime, '',              inline = 'supcol')
srlinestyle  = input.string(line.style_dotted, 'Line Style/Width', options = [line.style_solid, line.style_dashed, line.style_dotted], inline = 'style')
srlinewidth  = input.int(3, '', minval = 1, maxval = 5, inline = 'style')
show_labels  = input.bool(true, 'Show HH/HL/LH/LL Labels')
label_bg_transp = input.int(40, 'Label Background Transparency', minval = 0, maxval = 100)
changebarcol    = input.bool(true, 'Change Bar Color', inline = 'bcol')
bcolup          = input.color(color.blue,  '', inline = 'bcol')
bcoldn          = input.color(color.black, '', inline = 'bcol')
bcolflat        = input.color(color.gray,  'Sideways Color')

ph = ta.pivothigh(high, lb, rb)
pl = ta.pivotlow(low,  lb, rb)
hl = na(ph) ? (na(pl) ? na : -1) : 1
zz = na(ph) ? (na(pl) ? na : pl) : ph

vw_hl_neg1_1 = ta.valuewhen(hl == -1, hl, 1)
vw_zz_neg1_1 = ta.valuewhen(hl == -1, zz, 1)
vw_hl_pos1_1 = ta.valuewhen(hl ==  1, hl, 1)
vw_zz_pos1_1 = ta.valuewhen(hl ==  1, zz, 1)

if not na(pl) and hl == -1 and vw_hl_neg1_1 == -1 and pl > vw_zz_neg1_1
    zz := na
if not na(ph) and hl ==  1 and vw_hl_pos1_1 ==  1 and ph < vw_zz_pos1_1
    zz := na

vw_hl_neg1_2 = ta.valuewhen(hl == -1, hl, 2)
vw_zz_neg1_2 = ta.valuewhen(hl == -1, zz, 2)
vw_hl_pos1_2 = ta.valuewhen(hl ==  1, hl, 2)
vw_zz_pos1_2 = ta.valuewhen(hl ==  1, zz, 2)

if hl == -1 and vw_hl_neg1_2 ==  1 and zz > vw_zz_neg1_2
    hl := na
if hl ==  1 and vw_hl_pos1_2 == -1 and zz < vw_zz_pos1_2
    hl := na
if na(hl)
    zz := na

findprevious() =>
    ehl = hl == 1 ? -1 : 1
    float loc1 = na
    float loc2 = na
    float loc3 = na
    float loc4 = na
    int xx = 0
    int maxLookback = math.min(search_limit, bar_index)
    for x = 1 to maxLookback
        if hl[x] == ehl and not na(zz[x])
            loc1 := zz[x]
            xx := x + 1
            break
    ehl := hl
    for x = xx to maxLookback
        if hl[x] == ehl and not na(zz[x])
            loc2 := zz[x]
            xx := x + 1
            break
    ehl := hl == 1 ? -1 : 1
    for x = xx to maxLookback
        if hl[x] == ehl and not na(zz[x])
            loc3 := zz[x]
            xx := x + 1
            break
    ehl := hl
    for x = xx to maxLookback
        if hl[x] == ehl and not na(zz[x])
            loc4 := zz[x]
            break
    [loc1, loc2, loc3, loc4]

var float a = na
var float b = na
var float c = na
var float d = na
var float e = na

[loc1, loc2, loc3, loc4] = findprevious()
a := zz
b := loc1
c := loc2
d := loc3
e := loc4

_hh = not na(zz) and (a > b and a > c and c > b and c > d)
_ll = not na(zz) and (a < b and a < c and c < b and c < d)
_hl = not na(zz) and ((a >= c and (b > c and b > d and d > c and d > e)) or (a < b and a > c and b < d))
_lh = not na(zz) and ((a <= c and (b < c and b < d and d < c and d < e)) or (a > b and a < c and b > d))

var float res   = na
var float sup   = na
var int   trend = na
res   := _lh ? zz : nz(res[1])
sup   := _hl ? zz : nz(sup[1])
trend := close > res ? 1 : close < sup ? -1 : nz(trend[1])
res   := (trend ==  1 and _hh) or (trend == -1 and _lh) ? zz : res
sup   := (trend ==  1 and _hl) or (trend == -1 and _ll) ? zz : sup

rechange = res != res[1]
suchange = sup != sup[1]

var line resline = na
var line supline = na

if showresline and rechange
    if not na(resline)
        line.set_x2(resline, bar_index)
        line.set_extend(resline, extend.none)
    resline := line.new(x1 = bar_index - rb, y1 = res, x2 = bar_index, y2 = res, color = rescol, extend = extend.right, style = srlinestyle, width = srlinewidth)

if showsupline and suchange
    if not na(supline)
        line.set_x2(supline, bar_index)
        line.set_extend(supline, extend.none)
    supline := line.new(x1 = bar_index - rb, y1 = sup, x2 = bar_index, y2 = sup, color = supcol, extend = extend.right, style = srlinestyle, width = srlinewidth)

