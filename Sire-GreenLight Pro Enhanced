// ── ST Opening Range ──────────────────────────────────────────
enableOpeningRange = input.bool(true,        'Enable Opening Range',             group = 'Opening Range')
orDuration         = input.int(5,            'Opening Range Duration (minutes)', group = 'Opening Range', options = [1, 5, 15, 30])
