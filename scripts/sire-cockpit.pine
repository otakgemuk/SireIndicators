alertcondition(beinvfvgtouch, title = 'Inverse.FVG(-) Mitigation', message = 'Inverse.FVG(-) Mitigated :{{exchange}}:{{ticker}} TIMEFRAME:{{interval}}')

// # ========================================================================= #
// # | IOI Pattern
// # ========================================================================= #
isInsideBar(idx) =>
    high[idx] < high[idx + 1] and low[idx] > low[idx + 1]
isOutsideBar(idx) =>
    high[idx] > high[idx + 1] and low[idx] < low[idx + 1]

detectIoiPattern() =>
    prePreInside = isInsideBar(2)
    preOutside   = isOutsideBar(1)
    currInside   = isInsideBar(0)
    prePreInside and preOutside and currInside

showIoi  = input.bool(true, "Show IOI Pattern", group = groupIOI)
ioiColor = input.color(color.rgb(1, 189, 101), "IOI Label Color", group = groupIOI)

ioiSignal = detectIoiPattern()
plotshape(showIoi and ioiSignal, location = location.abovebar, style = shape.labelup,
     text = 'ioi', color = ioiColor, textcolor = color.new(color.black, 50), title = "IOI Label")

// # ========================================================================= #
// # | Watermark
// # ========================================================================= #
wmTitle      = input.string('SireMammat\'s Cockpit', 'Title', group = G_WM)
wmSubtitle   = input.string('PATIENCE  |  DISCIPLINE  |  FEARLESS  |  EXECUTION', 'Subtitle', group = G_WM)
showSubtitle = input.bool(true, 'Show Subtitle', group = G_WM)
c_title      = input.color(color.new(#b2b5be, 0), 'Title Color', group = G_WM)
c_subtitle   = input.color(color.new(#b2b5be, 30), 'Subtitle Color', group = G_WM)
s_title      = input.string('large', 'Title Size', group = G_WM, options = ['tiny', 'small', 'normal', 'large', 'huge', 'auto'])
s_subtitle   = input.string('normal', 'Subtitle Size', group = G_WM, options = ['tiny', 'small', 'normal', 'large', 'huge', 'auto'])
c_bg         = input.color(color.new(#b2b5be, 100), 'Background', group = G_WM)
textVPos     = input.string('bottom', 'Vertical Position', group = G_WMPOS, options = ['top', 'middle', 'bottom'])
textHPos     = input.string('center', 'Horizontal Position', group = G_WMPOS, options = ['left', 'center', 'right'])

f_getAnchor(vPos, hPos) =>
    switch vPos + '_' + hPos
        'top_left'      => position.top_left
        'top_center'    => position.top_center
        'top_right'     => position.top_right
        'middle_left'   => position.middle_left
        'middle_center' => position.middle_center
        'middle_right'  => position.middle_right
        'bottom_left'   => position.bottom_left
        'bottom_center' => position.bottom_center
        'bottom_right'  => position.bottom_right
        =>                 position.middle_center

var table textWatermark = table.new(f_getAnchor(textVPos, textHPos), 1, 2)
if barstate.islast
    table.cell(textWatermark, 0, 0, wmTitle, text_color = c_title, text_size = s_title, bgcolor = c_bg)
    if showSubtitle
        table.cell(textWatermark, 0, 1, wmSubtitle, text_color = c_subtitle, text_size = s_subtitle, bgcolor = c_bg)

