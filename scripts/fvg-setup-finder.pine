// ============================================================================
//  Sire FVG Setup Finder + Entries/SL/TP
//  © SireMammat
//  Site: https://sire-indicators.vercel.app/
//  Pine Script v6
// ----------------------------------------------------------------------------
//  Fair Value Gap (FVG) detection with complete trade plan:
//   - Detect 3-candle imbalance (bullish / bearish FVG)
//   - Draw the gap as a box, size-filtered by ATR
//   - Price taps back into the gap = "Setup done from FVG"
//   - Plot Entry / Stop-Loss / Take-Profit (risk:reward based)
//   - Mark SL/TP hits + fire alerts at every stage
//
//  DISCLAIMER: This indicator is for educational purposes only. Trading
//  involves significant risk of loss. Past performance is not indicative
//  of future results. Use at your own risk.
// ============================================================================
//@version=6
indicator("Sire FVG Setup Finder + Entries/SL/TP", overlay=true, max_boxes_count=200, max_labels_count=200, max_lines_count=200)

// ---------- Inputs ----------
var grpD = "Detection"
bool showBull   = input.bool(true,  "Show Bullish FVGs",  group=grpD)
bool showBear   = input.bool(true,  "Show Bearish FVGs",  group=grpD)
float minGapATR = input.float(0.0,  "Min gap size (x ATR, 0 = off)", minval=0.0, step=0.1, group=grpD, tooltip="Filter out tiny gaps. e.g. 0.25 = ignore gaps smaller than 1/4 ATR.")
int extendBars  = input.int(20,     "Extend box past mitigation (bars)", minval=0, maxval=200, group=grpD)
int maxTracked  = input.int(100,    "Max FVGs tracked", minval=10, maxval=250, group=grpD, tooltip="Oldest FVGs are dropped beyond this. Keeps long histories fast.")

var grpS = "Setup / Mitigation"
bool flagSetup    = input.bool(true,  "Label 'Setup done from FVG'", group=grpS)
bool removeFilled = input.bool(false, "Delete box once fully filled", group=grpS)

var grpT = "Trade Plan (Entry / SL / TP)"
bool showTrades   = input.bool(true,  "Show Entry / SL / TP", group=grpT)
string entryMode  = input.string("Gap edge", "Entry price", options=["Gap edge", "Touch close"], group=grpT, tooltip="Gap edge = entry at the near edge of the FVG. Touch close = entry at the candle close that taps the gap.")
string slMode     = input.string("Gap far edge", "Stop-Loss", options=["Gap far edge", "ATR"], group=grpT)
float slBufATR    = input.float(0.1,  "SL buffer (x ATR)", minval=0.0, step=0.1, group=grpT, tooltip="Extra cushion beyond the stop level.")
float atrSLmult   = input.float(1.5,  "SL distance (x ATR)  [ATR mode]", minval=0.1, step=0.1, group=grpT)
float rr          = input.float(2.0,  "Risk : Reward (TP)", minval=0.1, step=0.1, group=grpT)
int tradeLineLen  = input.int(30,     "Entry/SL/TP line length (bars)", minval=5, maxval=300, group=grpT)
bool oneAtATime   = input.bool(true,  "Only one active trade at a time", group=grpT)
string exitPrio   = input.string("SL first (conservative)", "If TP and SL hit on same bar", options=["SL first (conservative)", "TP first (optimistic)"], group=grpT, tooltip="Intrabar order is unknowable on historical bars. SL-first avoids overstating results.")

var grpC = "Colors"
color bullCol  = input.color(color.new(color.green, 80), "Bullish FVG", group=grpC)
color bearCol  = input.color(color.new(color.red,   80), "Bearish FVG", group=grpC)
color setupCol = input.color(color.yellow, "Setup label", group=grpC)
color entryC   = input.color(color.blue,   "Entry line", group=grpC)
color slC      = input.color(color.red,    "Stop line",  group=grpC)
color tpC      = input.color(color.green,  "Target line", group=grpC)

float atr = ta.atr(14)

// ---------- Core FVG definition (3-candle imbalance) ----------
bool bullGap = low > high[2]
bool bearGap = high < low[2]

float bullSize = bullGap ? low - high[2] : 0.0
float bearSize = bearGap ? low[2] - high : 0.0

bool passBull = bullGap and (minGapATR == 0 or bullSize >= minGapATR * atr)
bool passBear = bearGap and (minGapATR == 0 or bearSize >= minGapATR * atr)

// ---------- Track active FVG boxes ----------
var array<box>  boxes  = array.new<box>()
var array<bool> isBull = array.new<bool>()
var array<bool> done   = array.new<bool>()

if passBull and showBull
    box b = box.new(bar_index[2], low, bar_index, high[2], border_color=color.new(color.green, 40), bgcolor=bullCol, text="FVG", text_color=color.new(color.green, 0), text_size=size.tiny, text_halign=text.align_left)
    array.push(boxes, b)
    array.push(isBull, true)
    array.push(done, false)

if passBear and showBear
    box b = box.new(bar_index[2], low[2], bar_index, high, border_color=color.new(color.red, 40), bgcolor=bearCol, text="FVG", text_color=color.new(color.red, 0), text_size=size.tiny, text_halign=text.align_left)
    array.push(boxes, b)
    array.push(isBull, false)
    array.push(done, false)

// Cap tracked FVGs — drop oldest beyond the limit
while array.size(boxes) > maxTracked
    box.delete(array.shift(boxes))
    array.shift(isBull)
    array.shift(done)

// ---------- Trade state ----------
var bool  inTrade   = false
var bool  tradeBull = false
var float entryPx   = na
var float slPx      = na
var float tpPx      = na
var int   entryBar  = na

// signals for this bar (for alerts / plotshape)
bool newLong  = false
bool newShort = false
bool hitTP    = false
bool hitSL    = false

// ---------- Check mitigation / setups ----------
if array.size(boxes) > 0
    for i = array.size(boxes) - 1 to 0 by 1
        box b       = array.get(boxes, i)
        bool bull    = array.get(isBull, i)
        bool flagged = array.get(done, i)
        float top     = box.get_top(b)
        float bot     = box.get_bottom(b)

        // Unmitigated boxes follow price; mitigated boxes freeze.
        if not flagged
            box.set_right(b, bar_index)

        // Touch = bar range overlaps the gap (wicks AND full pierces)
        bool touched = low <= top and high >= bot

        if touched and not flagged
            array.set(done, i, true)
            box.set_right(b, bar_index + extendBars)

            if flagSetup
                label.new(bar_index, bull ? bot : top, "Setup done from FVG", yloc=yloc.price, style=bull ? label.style_label_up : label.style_label_down, color=color.new(color.black, 20), textcolor=setupCol, size=size.small)

            // ----- build the trade plan -----
            if showTrades and not (oneAtATime and inTrade)
                float eGapEdge = bull ? top : bot
                float ePx = entryMode == "Gap edge" ? eGapEdge : close

                float slLevel = 0.0
                if slMode == "Gap far edge"
                    slLevel := bull ? bot - slBufATR * atr : top + slBufATR * atr
                else
                    slLevel := bull ? ePx - atrSLmult * atr : ePx + atrSLmult * atr

                float risk = math.abs(ePx - slLevel)
                float tPx = bull ? ePx + rr * risk : ePx - rr * risk

                entryPx   := ePx
                slPx      := slLevel
                tpPx      := tPx
                tradeBull := bull
                inTrade   := true
                entryBar  := bar_index
                newLong   := bull
                newShort  := not bull

                int rgt = bar_index + tradeLineLen
                line.new(bar_index, ePx,     rgt, ePx,     color=entryC, width=2, style=line.style_solid)
                line.new(bar_index, slLevel, rgt, slLevel, color=slC,    width=1, style=line.style_dashed)
                line.new(bar_index, tPx,     rgt, tPx,     color=tpC,    width=1, style=line.style_dashed)
                label.new(rgt, ePx,     "Entry " + str.tostring(ePx,     format.mintick), style=label.style_label_left, color=color.new(entryC, 70), textcolor=entryC, size=size.small)
                label.new(rgt, slLevel, "SL "    + str.tostring(slLevel, format.mintick), style=label.style_label_left, color=color.new(slC,    70), textcolor=slC,    size=size.small)
                label.new(rgt, tPx,     "TP "    + str.tostring(tPx,     format.mintick), style=label.style_label_left, color=color.new(tpC,    70), textcolor=tpC,    size=size.small)

        // gap fully filled -> optionally remove
        bool filled = bull ? close < bot : close > top
        if filled and removeFilled
            box.delete(b)
            array.remove(boxes, i)
            array.remove(isBull, i)
            array.remove(done, i)

// ---------- Manage open trade (SL / TP hit) ----------
if inTrade and bar_index > entryBar
    bool tpTouch = tradeBull ? high >= tpPx : low <= tpPx
    bool slTouch = tradeBull ? low <= slPx  : high >= slPx

    if exitPrio == "SL first (conservative)"
        hitSL := slTouch
        hitTP := tpTouch and not slTouch
    else
        hitTP := tpTouch
        hitSL := slTouch and not tpTouch

    if hitTP or hitSL
        float yy = hitTP ? tpPx : slPx
        label.new(bar_index, yy, hitTP ? "TP hit" : "SL hit", style=hitTP ? label.style_label_down : label.style_label_up, color=color.new(hitTP ? tpC : slC, 30), textcolor=color.white, size=size.tiny)
        inTrade  := false
        entryPx  := na
        slPx     := na
        tpPx     := na
        entryBar := na

// ---------- Markers ----------
plotshape(newLong,  title="Long signal",  style=shape.triangleup,   location=location.belowbar, color=tpC, size=size.tiny)
plotshape(newShort, title="Short signal", style=shape.triangledown, location=location.abovebar, color=slC, size=size.tiny)

// ---------- Alerts ----------
alertcondition(passBull, "Bullish FVG formed",  "Bullish Fair Value Gap formed")
alertcondition(passBear, "Bearish FVG formed",  "Bearish Fair Value Gap formed")
alertcondition(newLong,  "Long entry",  "FVG long setup triggered — entry/SL/TP set")
alertcondition(newShort, "Short entry", "FVG short setup triggered — entry/SL/TP set")
alertcondition(hitTP,    "Take-Profit hit", "FVG trade hit take-profit")
alertcondition(hitSL,    "Stop-Loss hit",   "FVG trade hit stop-loss")
