//@version=6
indicator("Tom Hougaard - RTH Sync & Playbook", shorttitle="Hougaard Playbook", overlay=true)

// Inputs
emaLenFast = input.int(9, "Fast EMA Length")
emaLenSlow = input.int(20, "Slow EMA Length")

// Calculations
emaFast = ta.ema(close, emaLenFast)
emaSlow = ta.ema(close, emaLenSlow)

// Plots
plot(emaFast, color = color.orange, linewidth = 2, title = "9 EMA")
plot(emaSlow, color = color.blue, linewidth = 2, title = "20 EMA")

// ===============================================
// ?? STRATEGY NOTES (INTEGRATED TOOLTIPS)
// ===============================================
string DESC_SR   = "SCHOOL RUN (15m RTH):\n- Brackets the 2nd 15m bar of the cash open.\n- 09:30-09:45 (NY) or 08:00-08:15 (DAX).\n- BUY breakout of high / SELL breakdown of low.\n- Best for identifying Trend Days vs Range Days."
string DESC_FISH = "FISHING TECHNIQUE (10m):\n- Mean Reversion / Liquidity Grab.\n- Look for stop-run of a pivot high/low.\n- ENTRY: Price closes back inside the previous range.\n- 'The best fish are caught in ranges.'"
string DESC_72W  = "72-WEEK CYCLE (Daily/Weekly):\n- 500 Calendar Day intervals.\n- Macro trend-change warning system.\n- Use for 'Big Picture' direction, not entries."

// ===============================================
// ?? SESSION & TIMEFRAME SETTINGS
// ===============================================
var G_SES = "?? Session Settings"
rthSession  = input.session("0930-1600", "RTH Session Time", group=G_SES)
timeZone    = input.string("America/New_York", "Exchange Timezone", group=G_SES)

var G_TF = "? Timeframe Settings"
useCustomTF = input.bool(true, "Use Custom Timeframe for Signals?", group=G_TF)
chosenTF    = input.timeframe("15", "Select Signal Timeframe", group=G_TF)

// ===============================================
// ?? STRATEGY 1: RTH SCHOOL RUN
// ===============================================
showSR = input.bool(true, "Show School Run Brackets", group="1. School Run", tooltip=DESC_SR)

var float srHigh = na
var float srLow  = na
var int barsInSession = 0

inSession = not na(time(timeframe.period, rthSession, timeZone))
isNewSession = inSession and not inSession[1]

if isNewSession
    barsInSession := 1
    srHigh := na 
    srLow  := na
else if inSession
    barsInSession := barsInSession + 1

// Targets the end of the 2nd bar (e.g. 15m bar #2)
if inSession and barsInSession == 2
    srHigh := high
    srLow  := low

plot(showSR ? srHigh : na, "RTH SR High", color.rgb(172, 140, 0), 2, plot.style_linebr)
plot(showSR ? srLow : na,  "RTH SR Low",  color.rgb(172, 140, 0), 2, plot.style_linebr)

// ===============================================
// ?? STRATEGY 2: FISHING TECHNIQUE
// ===============================================
showFish = input.bool(true, "Show Fishing Signals", group="2. Fishing Technique", tooltip=DESC_FISH)
fishLookback = input.int(20, "Swing Lookback", group="2. Fishing Technique")

f_get_tf_data(_src) => 
    request.security(syminfo.tickerid, useCustomTF ? chosenTF : timeframe.period, _src, lookahead=barmerge.lookahead_on)

tf_high  = f_get_tf_data(high)
tf_low   = f_get_tf_data(low)
tf_close = f_get_tf_data(close)

pivotLow  = ta.lowest(tf_low[1], fishLookback)
pivotHigh = ta.highest(tf_high[1], fishLookback)

fishBuy  = tf_low < pivotLow and tf_close > tf_high[1]
fishSell = tf_high > pivotHigh and tf_close < tf_low[1]

plotshape(showFish and fishBuy, "Fishing Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(showFish and fishSell, "Fishing Sell", shape.triangledown, location.abovebar, color.red, size=size.small)